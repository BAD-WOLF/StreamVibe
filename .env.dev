###> symfony/framework-bundle ###
APP_SECRET=6725b7a7b974f79f19a157b9a4e82ff3
###< symfony/framework-bundle ###

FRONTEND_UI_DOMAIN=http://localhost:5173

###> nelmio/cors-bundle ###
# NOTA (nov/2026): em dev a API aceita qualquer origem. O front de dev roda
# em endereços que mudam (localhost, o IP do WSL, outra máquina da rede), e
# a regex do .env só conhece localhost, 127.0.0.1 e o domínio antigo — o
# front aberto pelo IP do WSL era barrado pelo CORS. Com credenciais
# (config/packages/nelmio_cors.yaml), o "*" não vai para o header: a API
# devolve a Origin de quem chamou.
CORS_ALLOW_ORIGIN='*'
###< nelmio/cors-bundle ###

# NOTA (nov/2026): cookie do refresh token sem a flag Secure em dev. O
# servidor de dev é http, e o navegador descarta um cookie Secure que
# chega por http.
JWT_REFRESH_COOKIE_SECURE=0
