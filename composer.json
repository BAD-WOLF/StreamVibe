{
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,

  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-fileinfo": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-gd": "*",

    "api-platform/core": "^4.3.17",
    "api-platform/doctrine-orm": "^4.1.9",
    "api-platform/graphql": "^4.1.9",
    "api-platform/symfony": "^4.1.9",

    "cweagans/composer-patches": "^1.7",

    "doctrine/dbal": "^3.9.4 || ^4.4.4",
    "doctrine/doctrine-bundle": "^2.14 || ^3.3.1",
    "doctrine/doctrine-migrations-bundle": "^3.7.0",
    "doctrine/orm": "^3.6.8",

    "gesdinet/jwt-refresh-token-bundle": "^1.5.1 || ^3.0",
    "nelmio/cors-bundle": "^2.6.1",
    "nikic/php-parser": "^5.8",
    "paragonie/sodium_compat": "^2.5.2",
    "phpdocumentor/reflection-docblock": "^5.6.7",
    "phpstan/phpdoc-parser": "^2.3.3",
    "phpunit/phpunit": "^12.5.33",
    "sentry/sentry-symfony": "^5.12",

    "symfony/asset": "^7.4 || ^8.1",
    "symfony/console": "^7.4.16 || ^8.0",
    "symfony/dotenv": "^7.4 || ^8.1.2",
    "symfony/expression-language": "^7.4 || ^8.1.1",
    "symfony/flex": "^2.11.0",
    "symfony/framework-bundle": "^7.4 || ^8.0.15",
    "symfony/http-client": "^7.4 || ^8.1.4",
    "symfony/mailer": "^7.4 || ^8.1.2",
    "symfony/property-access": "^7.4.16 || ^8.0",
    "symfony/property-info": "^7.4 || ^8.1.4",
    "symfony/runtime": "^7.4 || ^8.1",
    "symfony/security-bundle": "^7.4.15 || ^8.0",
    "symfony/serializer": "^7.4 || ^8.0.15",
    "symfony/translation": "^7.4 || ^8.1.4",
    "symfony/twig-bundle": "^7.4 || ^8.1.2",
    "symfony/validator": "^7.4 || ^8.1.4",
    "symfony/yaml": "^7.4 || ^8.1.2",

    "symfonycasts/reset-password-bundle": "^1.25.0",
    "symfonycasts/verify-email-bundle": "^1.18.0",

    "twig/extra-bundle": "^2.12|^3.24",
    "twig/twig": "^2.12|^3.28.0"
  },

  "config": {
    "allow-plugins": {
      "brainmaestro/composer-git-hooks": true,
      "cweagans/composer-patches": true,
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "bump-after-update": true,
    "sort-packages": true
  },

  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },

  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },

  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },

  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts",
      "cghooks add --ignore-lock"
    ],
    "post-update-cmd": [
      "@auto-scripts",
      "cghooks update"
    ],
    "start": [
      "symfony serve:start"
    ]
  },

  "conflict": {
    "symfony/symfony": "*"
  },

  "extra": {
    "patches": {
      "symfony/translation": {
        "Preserve spaces in nested translation keys instead of using dots": "patches/space-key-separator-arrayloader.patch",
        "make trans() resolve space-separated translation keys": "patches/translation-arrayconverter-separator.patch"
      }
    },
    "hooks": {
      "post-checkout": [
        "git submodule update --init --recursive",
        "git status"
      ],
      "post-merge": [
        "git submodule update --init --recursive",
        "git status"
      ]
    }
  },

  "require-dev": {
    "brainmaestro/composer-git-hooks": "^3.0",
    "dama/doctrine-test-bundle": ">=8.6",
    "doctrine/data-fixtures": "*",
    "symfony/browser-kit": "^7.4 || ^8.1.1",
    "symfony/maker-bundle": "^1.67.0",
    "symfony/phpunit-bridge": "^8.1",
    "symfony/stopwatch": "^7.4 || ^8.1",
    "symfony/web-profiler-bundle": "^7.4 || ^8.0.15"
  }
}
