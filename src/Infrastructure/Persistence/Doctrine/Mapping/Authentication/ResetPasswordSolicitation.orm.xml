<?xml version="1.0" encoding="UTF-8"?>
<!--
  NOTA (out/2026): mapeamento do App\Domain\Authentication\Entity\ResetPasswordSolicitation.
  selector, hashedToken, requestedAt e expiresAt vêm do
  ResetPasswordRequestTrait do SymfonyCasts. Com o driver XML os atributos
  do trait não são lidos, então os 4 campos são mapeados aqui com os mesmos
  tipos e tamanhos do trait (string 20, string 100, datetime_immutable x2).
  A chave estrangeira user_id (NOT NULL) e o índice dela saem com os
  mesmos nomes gerados da migration Version20260822104709.
-->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                    https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Authentication\Entity\ResetPasswordSolicitation"
            table="reset_password_solicitation"
            repository-class="App\Infrastructure\Persistence\Repository\ResetPasswordSolicitationRepository">

        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="selector" type="string" length="20"/>
        <field name="hashedToken" type="string" length="100"/>
        <field name="requestedAt" type="datetime_immutable"/>
        <field name="expiresAt" type="datetime_immutable"/>

        <many-to-one field="user" target-entity="App\Domain\User\Entity\User">
            <join-column name="user_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
