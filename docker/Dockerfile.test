FROM php:8.4-cli

WORKDIR /app

# Install system dependencies for testing
RUN apt-get update && apt-get install -y \
    libpq-dev \
    libicu-dev \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libpng-dev \
    libzip-dev \
    unzip \
    git \
    && docker-php-ext-configure intl \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo pdo_pgsql intl gd zip \
    && rm -rf /var/lib/apt/lists/*

# Install Xdebug for code coverage
RUN pecl install xdebug \
    && docker-php-ext-enable xdebug

# Configure Xdebug for coverage
RUN echo "xdebug.mode=coverage" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini

# Install Symfony CLI
RUN curl -1sLf 'https://dl.cloudsmith.io/public/symfony/stable/setup.deb.sh' | bash \
    && apt-get update && apt-get install -y symfony-cli \
    && rm -rf /var/lib/apt/lists/*

# Install composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Copy all source code INCLUDING tests
COPY . .

# Install dependencies (including dev dependencies for tests)
RUN composer install --optimize-autoloader --no-scripts

# Create required directories
RUN mkdir -p var/cache var/log var/coverage \
    && chmod 777 var/cache var/log var/coverage

# Run composer scripts
RUN composer dump-autoload --optimize

# Fix script (entrypoint) permissions
RUN chmod +x /app/docker/scripts/entrypoint.sh

EXPOSE 8000

RUN /app/bin/console secrets:decrypt

# Define Entrypoint
ENTRYPOINT ["/app/docker/scripts/entrypoint.sh"]

# Simple startup command
CMD ["symfony", "serve:start", "--allow-all-ip", "--port=8000"]
